{
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": ["http://localhost:18789", "http://127.0.0.1:18789"]
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://ollama:11434",
        "api": "ollama",
        "apiKey": "ollama",
        "models": [
          {
            "id": "gemma4:26b",
            "name": "Gemma4 26B",
            "input": ["text"],
            "contextWindow": 32768,
            "maxTokens": 8192
          },
          {
            "id": "qwen2.5vl:7b",
            "name": "Qwen 2.5 VL 7B",
            "input": ["text", "image"],
            "contextWindow": 32768,
            "maxTokens": 8192,
            "params": {
              "num_ctx": 4096,
              "keep_alive": "5m"
            },
            "compat": {
              "supportsTools": false
            }
          },
        ],
        "timeoutSeconds": 300
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {
        "primary": "ollama/gemma4:26b"
      },
      "timeoutSeconds": 600,
      "imageModel": {
        "primary": "ollama/qwen2.5vl:7b"
      },
      "models": {
        "ollama/qwen2.5vl:7b": {},
        "ollama/gemma4:26b": {}
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1",
    "lastTouchedAt": "2026-08-08T16:57:02.293Z"
  },
  "plugins": {
    "entries": {
      "ollama": {
        "enabled": true
      }
    }
  },
  "tools": {
    "byProvider": {
      "ollama/gemma4:26b": {
        "deny": ["group:web", "browser"]
      }
    },
    "media": {
      "image": {
        "timeoutSeconds": 300,
        "enabled": true,
        "maxChars": 4000,
        "prompt": "Transcribe all clearly readable text from this document image. Preserve headings and line breaks where possible. Mark uncertain text as [unclear]. Do not invent missing text. After the transcription, briefly describe diagrams or layout features.",
        "models": [
          {
            "provider": "ollama",
            "model": "qwen2.5vl:7b",
            "timeoutSeconds": 300
          }
        ]
      }
    }
  }
}
